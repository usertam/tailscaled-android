 	return "/usr/local/bin:/usr/bin:/bin"
 }
 
+// pathFromInitEnviron returns the value of PATH from /proc/1/environ
+// (init's environment), or "" if it can't be read or doesn't set PATH.
+func pathFromInitEnviron() string {
+	b, err := os.ReadFile("/proc/1/environ")
+	if err != nil {
+		return ""
+	}
+	for _, kv := range bytes.Split(b, []byte{0}) {
+		if rest, ok := bytes.CutPrefix(kv, []byte("PATH=")); ok {
+			return string(rest)
+		}
+	}
+	return ""
+}
